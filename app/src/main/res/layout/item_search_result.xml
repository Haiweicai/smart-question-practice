<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 题号徽标 -->
    <TextView
        android:id="@+id/tv_item_num"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="1"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:textColor="?attr/ecoPrimary"
        android:background="@drawable/bg_search_num_badge"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="12dp">

        <!-- 题干摘要（命中关键词高亮） -->
        <TextView
            android:id="@+id/tv_item_stem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="题干"
            android:textSize="@dimen/text_size_medium"
            android:textColor="?attr/ecoTextPrimary"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"/>

        <!-- 元信息：题型 · 答案/提示 -->
        <TextView
            android:id="@+id/tv_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="单选题"
            android:textSize="@dimen/text_size_small"
            android:textColor="?attr/ecoTextHint"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</LinearLayout>
