<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 顶部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp"
        android:background="@drawable/top_bar_bg">

        <!-- 左侧：进度 + 题型 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <!-- 进度文本（1/200）- 不可点击 -->
            <TextView
                android:id="@+id/tv_question_number"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="1/10"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/ecoOnPrimary"
                android:background="@drawable/item_tag_bg"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginEnd="6dp"/>

            <!-- 题型标签（不可点击） -->
            <TextView
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="单选题"
                android:textSize="11sp"
                android:textColor="?attr/ecoOnPrimary"
                android:background="@drawable/item_tag_bg"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"/>

        </LinearLayout>

        <!-- 中间：激流进度条（弹性空间） -->
        <ProgressBar
            android:id="@+id/pb_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="8dp"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/progress_torrent"/>

        <!-- 右侧：模式 + 收藏 + 答题卡 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 模式按钮（3D） -->
            <TextView
                android:id="@+id/tv_mode"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="顺序模式"
                android:textSize="12sp"
                android:textColor="?attr/ecoOnPrimary"
                android:background="@drawable/mode_btn_3d"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginEnd="6dp"/>

            <!-- 收藏按钮（3D圆形） -->
            <TextView
                android:id="@+id/tv_favorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="☆"
                android:textSize="16sp"
                android:textColor="?attr/ecoTextSecondary"
                android:background="@drawable/favorite_btn_3d"
                android:gravity="center"
                android:layout_marginEnd="6dp"/>

            <!-- 答题卡按钮（3D） -->
            <LinearLayout
                android:id="@+id/tv_answer_card"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/answer_card_btn_3d"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/ic_answer_card_white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="答题卡"
                    android:textSize="11sp"
                    android:textColor="?attr/ecoOnPrimary"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- 题目内容区 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_questions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?attr/ecoSurface"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_previous"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:text="上一题"
            android:textSize="14sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:text="提交"
            android:textSize="14sp"
            android:backgroundTint="@color/btn_submit_bg_color"
            android:textColor="@color/btn_submit_text_color"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:text="下一题"
            android:textSize="14sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

    </LinearLayout>

</LinearLayout>
