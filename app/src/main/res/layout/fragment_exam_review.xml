<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/ecoBackground">

    <!-- 顶部：返回 + 进度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/ecoCardBg"
        android:elevation="2dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"
            android:textSize="@dimen/text_size_medium"
            android:textColor="?attr/ecoPrimary"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingRight="12dp"/>

        <TextView
            android:id="@+id/tv_review_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:text="第 1 题 / 共 0 题"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="?attr/ecoTextPrimary"/>

        <TextView
            android:id="@+id/btn_finish_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完成阅卷"
            android:textSize="@dimen/text_size_normal"
            android:textColor="?attr/ecoPrimary"/>
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_review"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- 底部打分区 -->
    <LinearLayout
        android:id="@+id/review_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/ecoCardBg"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本题得分"
                    android:textSize="@dimen/text_size_normal"
                    android:textColor="?attr/ecoTextPrimary"/>

                <EditText
                    android:id="@+id/et_score"
                    android:layout_width="84dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:inputType="numberDecimal"
                    android:hint="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/ecoPrimary"
                    android:background="@drawable/edittext_border"/>

                <TextView
                    android:id="@+id/tv_full_score"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:text="/ 满分 -- 分"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="?attr/ecoTextHint"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_prev"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="上一题"
            android:textSize="@dimen/text_size_normal"
            android:textColor="?attr/ecoPrimary"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/btn_next"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="下一题"
            android:textSize="@dimen/text_size_normal"
            android:textColor="?attr/ecoPrimary"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
</LinearLayout>
