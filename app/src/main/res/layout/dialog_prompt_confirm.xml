<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg">

    <!-- 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="22dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp">

        <TextView
            android:id="@+id/tv_prompt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="提示"
            android:textSize="@dimen/text_size_xlarge"
            android:textStyle="bold"
            android:textColor="?attr/ecoTextPrimary"/>

        <TextView
            android:id="@+id/btn_prompt_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:textSize="26sp"
            android:textColor="?attr/ecoTextSecondary"
            android:gravity="center"/>
    </LinearLayout>

    <!-- 消息内容 -->
    <TextView
        android:id="@+id/tv_prompt_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textSize="@dimen/text_size_medium"
        android:textColor="?attr/ecoTextSecondary"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="18dp"
        android:background="@color/divider"/>

    <!-- 按钮区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prompt_cancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:text="暂不"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            style="@style/Button.Secondary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prompt_confirm"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:text="确认"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            style="@style/Button.Primary"/>
    </LinearLayout>

</LinearLayout>
