<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/ecoBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/header_gradient">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_launcher_background"
            android:alpha="0.1"
            android:layout_marginRight="-20dp"
            android:layout_marginTop="-20dp"/>

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:src="@drawable/ic_launcher_background"
            android:alpha="0.1"
            android:layout_marginLeft="-10dp"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="回收站"
                android:textSize="@dimen/text_size_header"
                android:textColor="?attr/ecoOnPrimary"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_recycle_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除的题库可在7天内恢复"
                android:textSize="@dimen/text_size_subtitle"
                android:textColor="@color/text_white_secondary"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/layout_padding"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑️"
            android:textSize="@dimen/section_title_size"
            android:layout_marginRight="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已删除题库"
            android:textSize="@dimen/section_title_size"
            android:textColor="?attr/ecoTextPrimary"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_recycle_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0)"
            android:textSize="@dimen/text_size_normal"
            android:textColor="?attr/ecoTextSecondary"
            android:layout_marginLeft="8dp"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="@dimen/layout_padding"
        android:paddingRight="@dimen/layout_padding">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recycle_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:id="@+id/ll_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/empty_icon_size"
                android:layout_height="@dimen/empty_icon_size"
                app:cardBackgroundColor="?attr/ecoEmptyBg"
                app:cardCornerRadius="60dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗑️"
                        android:textSize="48sp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="回收站为空"
                android:textSize="@dimen/text_size_large"
                android:textColor="?attr/ecoTextSecondary"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除的题库会在这里显示"
                android:textSize="@dimen/text_size_normal"
                android:textColor="?attr/ecoTextHint"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/ll_bottom_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/layout_padding"
        android:paddingBottom="32dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_all"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="清空回收站"
            android:textSize="@dimen/text_size_medium"
            style="@style/Button.Secondary"
            app:cornerRadius="@dimen/corner_radius_large"/>

    </LinearLayout>

</LinearLayout>
