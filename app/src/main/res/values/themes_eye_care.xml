        <item name="ecoEmptyBg">#FFDCEDC8</item>
        <item name="ecoPrimary">#FF7CB342</item>
        <item name="ecoPrimaryLight">#FFA5D6A7</item>
        <item name="ecoPrimaryDark">#FF558B2F</item>
        <item name="ecoTextPrimary">#FF333333</item>
        <item name="ecoTextSecondary">#FF666666</item>
        <item name="ecoTextHint">#FF999999</item>
        <item name="ecoGradientStart">#FF8BC34A</item>
