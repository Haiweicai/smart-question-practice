<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/ecoBackground">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:background="@drawable/top_bar_bg">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/ecoPrimary"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingRight="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="考试排行榜"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/ecoPrimary"/>

        <TextView
            android:id="@+id/tv_rank_exam_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="?attr/ecoTextSecondary"
            android:maxWidth="140dp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- 排序切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="?attr/ecoSurface">

        <TextView
            android:id="@+id/tab_sort_score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="按得分排序"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/ecoOnPrimary"
            android:background="@drawable/badge_bg_secondary"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tab_sort_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="按用时排序"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/ecoTextSecondary"
            android:background="@drawable/badge_bg_primary"
            android:paddingVertical="8dp"/>
    </LinearLayout>

    <!-- 排行榜列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_rank"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        android:scrollbars="vertical"/>

    <!-- 空状态 -->
    <LinearLayout
        android:id="@+id/tv_empty_rank"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊"
            android:textSize="64sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="暂无成绩数据"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/ecoTextPrimary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="考生交卷后成绩将实时汇总到这里"
            android:textSize="13sp"
            android:textColor="?attr/ecoTextSecondary"/>
    </LinearLayout>

</LinearLayout>
