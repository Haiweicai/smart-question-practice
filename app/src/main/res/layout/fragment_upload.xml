<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/ecoBackground">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="导入题库"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/ecoTextPrimary"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/ll_file_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_select"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="?attr/ecoCardBg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/ll_select_area"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_add"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支持 txt、md、docx、Excel、pdf 格式"
                    android:textSize="12sp"
                    android:textColor="?attr/ecoTextHint"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_file_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_file_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="?attr/ecoTextPrimary"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_file_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/ecoPrimary"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btn_reselect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重新选择"
                    android:textSize="14sp"
                    android:textColor="?attr/ecoPrimary"
                    android:background="@null"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_file_select"/>

    <TextView
        android:id="@+id/tv_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="?attr/ecoTextSecondary"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/ll_preview_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_progress_text"
        app:layout_constraintBottom_toTopOf="@id/btn_confirm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="题目预览"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/ecoTextPrimary"/>

                <TextView
                    android:id="@+id/tv_question_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/ecoTextSecondary"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tv_filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全部"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoOnPrimary"
                        android:background="@drawable/filter_tag_selected_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginStart="4dp"/>

                    <TextView
                        android:id="@+id/tv_filter_ok"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="成功:0"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"
                        android:background="@drawable/filter_tag_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginStart="4dp"/>

                    <TextView
                        android:id="@+id/tv_filter_warning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="警告:0"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"
                        android:background="@drawable/filter_tag_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginStart="4dp"/>

                    <TextView
                        android:id="@+id/tv_filter_error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="异常:0"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"
                        android:background="@drawable/filter_tag_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_question_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/ecoCardBg"
            android:layout_marginBottom="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

    </LinearLayout>

    <ScrollView
        android:id="@+id/sv_example_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/ll_file_select"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/ll_example_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上传格式示例"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/ecoTextPrimary"
                android:layout_marginBottom="16dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/ecoSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="单选示例"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/ecoPrimary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10. 哲学史宛如色彩斑斓的壁毯…"
                        android:textSize="14sp"
                        android:textColor="?attr/ecoTextPrimary"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A. 唯物主义就是辩证法"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="B. 唯心主义就是形而上学"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="C. 唯物主义、唯心主义和辩证法、形而上学是对哲学基本问题两个方面的不同回答"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="D. 唯物主义与唯心主义的对立和斗争中交织着辩证法与形而上学的对立和斗争"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="答案：D"
                        android:textSize="13sp"
                        android:textColor="@color/green"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="解析：哲学基本问题第一方面是物质与意识何者第一性（唯物vs唯心），第二方面是世界是否可知（辩证法vs形而上学）。两者在哲学史中交织斗争。"
                        android:textSize="12sp"
                        android:textColor="?attr/ecoTextHint"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/ecoSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="多选示例"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/ecoPrimary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="当人类即将迈入21世纪的时候,英国广播公司(BBC)在全球范围内举行过一次\"
                        android:textSize="14sp"
                        android:textColor="?attr/ecoTextPrimary"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A. 观察当代世界变化的认识工具"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="B. 指引当代中国发展的行动指南"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="C. 引领人类社会进步的科学真理"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="D. 指导革命、建设、改革的现成方案"
                        android:textSize="13sp"
                        android:textColor="?attr/ecoTextSecondary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="答案:ABC"
                        android:textSize="13sp"
                        android:textColor="@color/green"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="解析:恩格斯指出:\"
                        android:textSize="12sp"
                        android:textColor="?attr/ecoTextHint"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/ecoSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="判断示例"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/ecoPrimary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="当今比较流行的技术研发模式是 B/S 和 C/S 体系结构来实现的。"
                        android:textSize="14sp"
                        android:textColor="?attr/ecoTextPrimary"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="答案:正确"
                        android:textSize="13sp"
                        android:textColor="@color/green"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/ecoSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="填空示例"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/ecoPrimary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="五阶段周期将网络系统设计过程划分为需求分析、通信分析、逻辑网络设计、物理网络设计和______五个阶段。"
                        android:textSize="14sp"
                        android:textColor="?attr/ecoTextPrimary"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="答案:安装和维护"
                        android:textSize="13sp"
                        android:textColor="@color/green"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/ecoSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="简答示例"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/ecoPrimary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="简述备份和容灾的区别"
                        android:textSize="14sp"
                        android:textColor="?attr/ecoTextPrimary"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="确认导入"
        android:textSize="18sp"
        android:textColor="?attr/ecoOnPrimary"
        android:background="?attr/ecoPrimary"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>