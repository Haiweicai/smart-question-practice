<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/ecoBackground">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="@drawable/top_bar_bg"
        android:elevation="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="?attr/ecoOnPrimary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:cornerRadius="20dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="考试记录管理"
            android:textAppearance="@style/TextAppearance.TitleLarge"
            android:textColor="?attr/ecoOnPrimary"/>
    </LinearLayout>

    <!-- 子模块切换 Tab 行 -->
    <LinearLayout
        android:id="@+id/tab_bar_history"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="?attr/ecoSurface"
        android:elevation="1dp">

        <TextView
            android:id="@+id/tab_published"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="我发布的考试"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/ecoOnPrimary"
            android:background="@drawable/badge_bg_secondary"/>

        <TextView
            android:id="@+id/tab_invited"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="我被邀请的考试"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/ecoTextSecondary"
            android:background="@drawable/badge_bg_primary"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tv_empty_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="📋\n\n暂无考试记录\n\n进入【创建模拟考试】完成一次考试后\n即可在此查看成绩和详情"
            android:textColor="?attr/ecoTextSecondary"
            android:textSize="@dimen/text_size_normal"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_exam_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="80dp"/>

        <!-- 多选删除底栏 -->
        <LinearLayout
            android:id="@+id/select_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:background="?attr/ecoSurface"
            android:elevation="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_select_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已选择 0 / 0"
                android:textColor="?attr/ecoTextPrimary"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="全选"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="20dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_select"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="取消"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="20dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_selected"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="删除"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_delete"
                app:iconSize="16dp"/>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
