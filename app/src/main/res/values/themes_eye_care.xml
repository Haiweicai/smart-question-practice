<?xml version="1.0" encoding="utf-8"?>
<!-- 护眼模式可选色主题：每套覆盖 16 个 eco 属性。
     Material 属性（colorPrimary/colorSurface 等）已在 Base.Theme.StudyTest 中
     映射为 ?attr/ecoXxx，故这里只需覆盖 eco 属性，Material 组件自动跟随。
     运行时由 EyeCareManager.applyTheme() 调 activity.setTheme(R.style.Theme_StudyTest_Xxx)。 -->
<resources>

    <!-- ============ 豆沙绿（默认护眼色，保留原 values-night 行为） ============ -->
    <style name="Theme.StudyTest.Green" parent="Theme.StudyTest">
        <item name="ecoSurface">#FFF5FAF0</item>
        <item name="ecoOnPrimary">#FFF5FAF0</item>
        <item name="ecoBackground">#FFE8F5E9</item>
        <item name="ecoCardBg">#FFF0F7E8</item>
