<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/card_background"
    android:layout_marginBottom="12dp"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_order"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/order_circle"
            android:textColor="?attr/ecoOnPrimary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginRight="12dp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?attr/ecoPrimary"
            android:background="?attr/ecoPrimaryLight"
            android:paddingVertical="6dp"
            android:paddingHorizontal="12dp"
            android:text="单选题"
            android:layout_marginRight="12dp"
            android:layout_marginEnd="12dp"/>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/gray_divider"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingStart="12dp">

            <ImageView
                android:id="@+id/iv_edit"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_edit"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp"
                android:tint="?attr/ecoTextHint"/>

            <ImageView
                android:id="@+id/iv_delete"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_delete"
                android:tint="?attr/ecoTextHint"/>

        </LinearLayout>

    </LinearLayout>

    <!-- 题干区域：文本 + 图片图标按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_stem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="?attr/ecoTextPrimary"
            android:lineSpacingExtra="6dp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/iv_stem_img"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="?attr/ecoPrimary"
            android:visibility="gone"
            android:contentDescription="题干有图片"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- 选项区域：文本 + 图片图标按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tv_options"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textColor="?attr/ecoTextSecondary"
            android:lineSpacingExtra="4dp"/>

        <ImageView
            android:id="@+id/iv_options_img"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="?attr/ecoPrimary"
            android:visibility="gone"
            android:contentDescription="选项有图片"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- 答案区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tv_answer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="答案："
            android:textSize="14sp"
            android:textColor="?attr/ecoTextHint"/>

        <TextView
            android:id="@+id/tv_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textColor="@color/green"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/iv_answer_img"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="?attr/ecoPrimary"
            android:visibility="gone"
            android:contentDescription="答案有图片"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- 解析区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tv_analysis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="?attr/ecoTextHint"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@color/gray_light"
            android:drawableLeft="@drawable/ic_info"
            android:drawablePadding="8dp"/>

        <ImageView
            android:id="@+id/iv_analysis_img"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="?attr/ecoPrimary"
            android:visibility="gone"
            android:contentDescription="解析有图片"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:padding="10dp"
        android:background="@color/error_light"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_warning"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:tint="@color/error" />

        <TextView
            android:id="@+id/tv_warning_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/error" />

    </LinearLayout>

</LinearLayout>
