<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/ecoBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/header_gradient">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_launcher_background"
            android:alpha="0.1"
            android:layout_marginRight="-20dp"
            android:layout_marginTop="-20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="考试监控"
                android:textSize="@dimen/text_size_header"
                android:textColor="?attr/ecoOnPrimary"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/text_size_subtitle"
                android:textColor="@color/text_white_secondary"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/tv_monitor_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="加载中…"
        android:textSize="@dimen/text_size_normal"
        android:textColor="?attr/ecoTextPrimary"
        android:textStyle="bold"
        android:paddingHorizontal="@dimen/layout_padding"
        android:paddingTop="@dimen/layout_padding"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/layout_padding"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无学生数据"
                android:textSize="@dimen/text_size_normal"
                android:textColor="?attr/ecoTextSecondary"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/ll_monitor_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
