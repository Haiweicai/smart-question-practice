<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 已收藏状态 -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#CCFF6F00" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFB74D"
                        android:endColor="#FFFF9800" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="5dp" android:left="1dp" android:right="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#CCBDBDBD" />
                </shape>
            </item>
            <item android:top="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#FF9E9E9E"
                        android:endColor="#FF757575" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 正常状态 -->
    <item>
        <layer-list>
            <!-- 底层阴影 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#CCBDBDBD" />
                </shape>
            </item>
            <!-- 主层 -->
            <item android:top="1dp" android:bottom="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#FFF5F5F5"
                        android:endColor="#FFE0E0E0" />
                </shape>
            </item>
            <!-- 高光层 -->
            <item android:top="1dp" android:bottom="5dp" android:left="1dp" android:right="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#99FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
