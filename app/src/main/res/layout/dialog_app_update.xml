<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg">

    <!-- 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="22dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="发现新版本"
            android:textSize="@dimen/text_size_xlarge"
            android:textStyle="bold"
            android:textColor="?attr/ecoTextPrimary"/>

        <TextView
            android:id="@+id/btn_update_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:textSize="26sp"
            android:textColor="?attr/ecoTextSecondary"
            android:gravity="center"/>
    </LinearLayout>

    <!-- 版本徽章 + 更新时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tv_update_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_version_badge"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="v1.0.0"
            android:textSize="@dimen/text_size_small"
            android:textColor="?attr/ecoOnPrimary"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_update_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text=""
            android:textSize="@dimen/text_size_small"
            android:textColor="?attr/ecoTextHint"/>
    </LinearLayout>

    <!-- 更新内容（Markdown 渲染，支持 Gitee 发布说明中的图片内联显示） -->
    <WebView
        android:id="@+id/wv_update_content"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="12dp"/>

    <!-- 下载进度区（初始隐藏，点击更新后显示） -->
    <LinearLayout
        android:id="@+id/layout_download_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pb_update_download"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_update_bar"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_update_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="@dimen/text_size_normal"
                android:textColor="?attr/ecoPrimary"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_update_size_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:text=""
                android:textSize="@dimen/text_size_small"
                android:textColor="?attr/ecoTextHint"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="8dp"
        android:background="@color/divider"/>

    <!-- 按钮区（下载时隐藏） -->
    <LinearLayout
        android:id="@+id/layout_update_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_update_later"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:text="稍后再说"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            style="@style/Button.Secondary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_update_now"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:text="立即更新"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            style="@style/Button.Primary"/>
    </LinearLayout>

    <!-- 下载中文本提示（初始隐藏） -->
    <TextView
        android:id="@+id/tv_update_downloading_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:text="正在下载更新，请稍候..."
        android:textSize="@dimen/text_size_small"
        android:textColor="?attr/ecoTextHint"
        android:visibility="gone"/>

</LinearLayout>
