<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ecoBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📝 题目"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/ecoPrimary"/>

                <ImageView
                    android:id="@+id/iv_stem_img"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="?attr/ecoPrimary"
                    android:visibility="gone"
                    android:contentDescription="题干图片"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_stem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="?attr/ecoTextPrimary"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 作答"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/ecoPrimary"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/et_answer"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:hint="请输入你的答案..."
                android:textSize="16sp"
                android:textColor="?attr/ecoTextPrimary"
                android:background="@drawable/edittext_border"
                android:padding="16dp"
                android:gravity="top"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:gravity="center"
                android:background="@color/error_light"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/ll_ai_grade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/ecoPrimaryLightBg"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_ai_grade_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/ecoPrimaryDark"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tv_ai_grade_hit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/green"
                    android:lineSpacingExtra="3dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_ai_grade_miss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/error"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_ai_grade_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/ecoTextSecondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/btn_ai_regrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 重新 AI 评判"
                    android:textSize="13sp"
                    android:textColor="?attr/ecoPrimary"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_score_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请为你的答案打分（满分10分）"
                android:textSize="14sp"
                android:textColor="?attr/ecoTextSecondary"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/ll_score_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="11">
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_reference_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="参考答案："
                    android:textSize="14sp"
                    android:textColor="?attr/ecoTextSecondary"/>

                <ImageView
                    android:id="@+id/iv_answer_img"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="?attr/ecoPrimary"
                    android:visibility="gone"
                    android:contentDescription="答案图片"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_reference_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/green"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_analysis_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💡 解析："
                    android:textSize="14sp"
                    android:textColor="?attr/ecoTextSecondary"/>

                <ImageView
                    android:id="@+id/iv_analysis_img"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="?attr/ecoPrimary"
                    android:visibility="gone"
                    android:contentDescription="解析图片"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_analysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="?attr/ecoTextPrimary"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
